{ s0: sor.u32 s0, 0x90000000, s0 ;
  misc: sbarrier.arrive [bflag:0x0], 0xffff }
{ misc: strace s0 }
{ s0: sfence }
{ misc: swait.eq [sflag:s5], 0x0 }
{ s0: @!p0 sadd.s32 s0, 0x100000, s4 ;
