{ s0: sadd.s32 s31, 0x4e, s3 ;
  misc: @!p0 swait.eq [sflag:s1], 0x0 }
{ s0: sfence.sel 0x180000 ;
  s1: sand.u32 s0, 0xfffffff, s31 ;
