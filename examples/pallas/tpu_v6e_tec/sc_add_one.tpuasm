{ vld: @!p0 vld v2, [tilespmem:0x100] ;
  .encoding { vld.offset = imm4 } }
{ vld: @!p0 vld v3, [tilespmem:0x180] ;
  .encoding { vld.offset = imm4 } }
{ vld: @!p0 vld v4, [tilespmem:0x200] ;
