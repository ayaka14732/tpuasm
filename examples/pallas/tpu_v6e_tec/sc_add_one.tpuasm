{ misc: @!p0 swait.ge [sflag:s1], 0x400 }
{ misc: @!p0 ssyncset.done [sflag:s1], 0x0 }
{ misc: @!p0 ssyncadd.s32 [sflag:s1], 0xfffffc00 }
{ vld: @!p0 vld v0, [tilespmem:0x0] }
{ vld: @!p0 vld v1, [tilespmem:0x80] ;
